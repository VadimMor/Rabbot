# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_change_me
RABBOT_MIGRATOR_PASSWORD=migrator_dev_change_me
RABBOT_APP_PASSWORD=app_dev_change_me

# Flyway: без seed для «чистой» базы -> filesystem:/flyway/sql
FLYWAY_LOCATIONS=filesystem:/flyway/seed

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_change_me

# Kafka (KRaft). CLUSTER_ID: любой base64 UUID из 22 символов,
# сгенерировать: docker run --rm apache/kafka:4.0.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_EXTERNAL_PORT=29092
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# Инструменты (profile: tools)
KAFKA_UI_PORT=8085
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@rabbot.ru
PGADMIN_PASSWORD=admin_dev_change_me