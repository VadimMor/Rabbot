{
  // Серверы для подключения к базе данных через pgAdmin.
  "Servers": {
    // Сервер с идентификатором "1" для локального подключения к базе данных Rabbot.
    "1": {
      // Название сервера, отображаемое в pgAdmin.
      "Name": "Rabbot (local)",
      // Группа, к которой принадлежит сервер в интерфейсе pgAdmin.
      "Group": "Rabbot",
      // Хост, на котором запущен контейнер с PostgreSQL. В Docker Compose имя сервиса используется как хост.
      "Host": "postgres",
      // Порт, на котором PostgreSQL слушает подключения. По умолчанию это 5432.
      "Port": 5432,
      // Имя базы данных для подключения. В данном случае это база данных "rabbot".
      "MaintenanceDB": "rabbot",
      // Имя пользователя для подключения к базе данных. Здесь используется пользователь "rabbot_migrator".
      "Username": "rabbot_migrator",
      // SSL режим подключения. "prefer" означает, что pgAdmin будет использовать SSL, если сервер поддерживает его, но не будет требовать его.
      "SSLMode": "prefer"
    }
  }
}